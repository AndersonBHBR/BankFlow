{
  "Jwt": {
    "Issuer": "bankflow.identity",
    "Audience": "bankflow.apis",
    "SigningKey": "",
    "ExpirationMinutes": 30
  },
  "ReverseProxy": {
    "Routes": {
      "identity-token": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "gateway-fixed",
        "Match": {
          "Path": "/api/v1/auth/token"
        }
      },
      "identity-current-user": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "gateway-fixed",
        "Match": {
          "Path": "/api/v1/auth/me"
        }
      },
      "transfers": {
        "ClusterId": "transfers",
        "AuthorizationPolicy": "transfers",
        "RateLimiterPolicy": "gateway-fixed",
        "Match": {
          "Path": "/api/v1/transfers/{**catch-all}"
        }
      },
      "accounts-read": {
        "ClusterId": "accounts",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "gateway-fixed",
        "Match": {
          "Path": "/api/v1/accounts/{**catch-all}",
          "Methods": ["GET"]
        }
      },
      "accounts-write": {
        "ClusterId": "accounts",
        "AuthorizationPolicy": "accounts",
        "RateLimiterPolicy": "gateway-fixed",
        "Match": {
          "Path": "/api/v1/accounts/{**catch-all}",
          "Methods": ["POST", "PUT", "PATCH", "DELETE"]
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8081"
          }
        }
      },
      "transfers": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8082"
          }
        }
      },
      "accounts": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8083"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
